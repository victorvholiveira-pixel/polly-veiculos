# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Environment — never commit real secrets/keys
.env
.env.*
!.env.example

# Test/coverage
coverage
playwright-report
test-results
blob-report

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local-only Postgres cluster used to validate migrations without Docker
# (see ARCHITECTURE.md — never a substitute for the real Supabase project)
.local-pg/

# Supabase CLI's own cache/metadata (created just by running `supabase`
# commands locally, e.g. to check for a linkable project) — never project content.
supabase/.temp/

# The legacy spreadsheet itself is never committed — only the pipeline code
# and its generated artifacts (artifacts/migration/) are.
data/source/
