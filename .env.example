# Copy this file to .env and fill in the real value after deploying the
# Apps Script Web App (see ARCHITECTURE.md, "Deploy do backend"). Never
# commit the real .env file.

# URL of the deployed Apps Script Web App (Deploy > New deployment > Web
# app > copy the URL). Safe to expose in the frontend bundle — it grants
# nothing by itself; every action still requires a valid login token (or,
# for automation only, the separate ADMIN_SECRET — never put that one in a
# VITE_ variable, it never belongs in the frontend at all).
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
