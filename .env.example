# Copy this file to .env and fill in the real values from your Supabase project
# (Project Settings → API). Never commit the real .env file.

# Public project URL — safe to expose in the frontend bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — safe to expose in the frontend bundle. It only grants
# whatever RLS policies allow; it is NOT the service_role key.
# NEVER put the service_role key in a VITE_ variable or anywhere in frontend code.
VITE_SUPABASE_ANON_KEY=your-anon-key
